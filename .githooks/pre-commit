#!/bin/sh
set -e   # abort on the first failing command, so a failed check doesn't get treated as a pass

branch=$(git rev-parse --abbrev-ref HEAD)
if [ "$branch" = "main" ]; then
  echo "Direct commits to main are not allowed. Please use a feature branch." >&2
  exit 1
fi

# Remember what was staged before the auto-fixers run (excluding deletions, which need no
# re-staging and would abort a literal `git add` with "pathspec did not match any files" once
# gone), so re-staging afterward can't sweep in unrelated tree-wide fixer drift the way
# `git add -u` would.
staged=$(git diff --cached --name-only --diff-filter=d)

npm run check                    # biome: lint + auto-fix formatting in src/, test/
npm run --if-present format:md   # prettier: auto-fix markdown (skipped if script absent)

[ -n "$staged" ] && echo "$staged" | git add --pathspec-from-file=-

npm run typecheck                # tsc --noEmit: fail if types don't compile
