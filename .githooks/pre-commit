#!/bin/sh
set -e   # abort on the first failing command, so a failed check doesn't get treated as a pass

branch=$(git rev-parse --abbrev-ref HEAD)
if [ "$branch" = "main" ]; then
  echo "Direct commits to main are not allowed. Please use a feature branch." >&2
  exit 1
fi

git_dir=$(git rev-parse --git-dir)
patch_file="$git_dir/PRE_COMMIT_UNSTAGED.patch"
rm -f "$patch_file"

# Auto-fixers run against the working tree, so any unstaged changes need to be out of the way —
# otherwise `git add -u` afterward would sweep unrelated WIP (or leftover hunks from a partial
# `git add -p`) into this commit. Save the unstaged diff as a patch and reset tracked files to
# match the index, so the fixers only ever see what's actually staged. (`git stash --keep-index`
# looks like the obvious tool here, but its pop does a 3-way merge against HEAD, not the index —
# it spuriously conflicts on any file that's *also* got staged changes, i.e. exactly a partial
# `git add -p`. A plain patch save/reapply doesn't have that problem.)
has_unstaged=0
if [ -n "$(git diff --name-only)" ]; then
  git diff --binary > "$patch_file"
  git checkout -- .
  has_unstaged=1
fi

# Reapplying the patch has to happen after `git commit` builds the commit object (a failed apply
# must never touch the index git is about to snapshot), so only restore immediately when the hook
# itself is aborting (commit won't happen); on success, defer to post-commit.
restore_on_abort() {
  status=$?
  if [ "$has_unstaged" = 1 ] && [ "$status" -ne 0 ]; then
    if git apply --whitespace=nowarn "$patch_file" 2>/dev/null; then
      rm -f "$patch_file"
    else
      echo "Could not reapply unstaged changes automatically — they're saved at $patch_file; apply with 'git apply $patch_file'." >&2
    fi
  fi
}
trap restore_on_abort EXIT

npm run check                    # biome: lint + auto-fix formatting in src/, test/
npm run --if-present format:md   # prettier: auto-fix markdown (skipped if script absent)
git add -u                       # safe now — working tree only ever held staged + fixer changes
npm run typecheck                # tsc --noEmit: fail if types don't compile
