nsparent)" stroke-width="1" stroke-dasharray="5, 5" transform="matrix(-0.22405287386589728, -0.9745769901410726, -0.9745769901410726, 0.22405287386589728, 400.27579122960884, 401.19962659626657)"></ellipse><text x="403" y="259.05111813311214" style="fill: color-mix(in srgb, currentColor 12%, transparent)" font-size="9" font-family="sans-serif" text-anchor="start">1.5 AU</text><text x="402.99999999999994" y="549.3481256338262" style="fill: color-mix(in srgb, currentColor 12%, transparent)" font-size="9" font-family="sans-serif" text-anchor="start">1.5 AU</text><ellipse cx="0" cy="0" rx="190.83665077732428" ry="190.7118821479518" fill="none" style="stroke: color-mix(in srgb, currentColor 12%, transparent)" stroke-width="1" stroke-dasharray="5, 5" transform="matrix(0.9138351443591641, 0.4060853714849447, 0.4060853714849447, -0.9138351443591641, 393.69484957362044, 397.198149612685)"></ellipse><text x="403" y="203.57292204966367" style="fill: color-mix(in srgb, currentColor 12%, transparent)" font-size="9" font-family="sans-serif" text-anchor="start">3.1 AU</text><text x="402.99999999999994" y="596.8294955479445" style="fill: color-mix(in srgb, currentColor 12%, transparent)" font-size="9" font-family="sans-serif" text-anchor="start">2.9 AU</text><ellipse cx="0" cy="0" rx="230.70418627486328" ry="230.67649438892667" fill="none" style="stroke: color-mix(in srgb, currentColor 12%, transparent)" stroke-width="1" stroke-dasharray="5, 5" transform="matrix(0.9670288287079861, -0.2546669284529509, -0.2546669284529509, -0.9670288287079861, 396.5434297237104, 400.9102873762518)"></ellipse><text x="403" y="167.25768629762686" style="fill: color-mix(in srgb, currentColor 12%, transparent)" font-size="9" font-family="sans-serif" text-anchor="start">5.1 AU</text><text x="403" y="640.562479763844" style="fill: color-mix(in srgb, currentColor 12%, transparent)" font-size="9" font-family="sans-serif" text-anchor="start">5.3 AU</text><ellipse cx="0" cy="0" rx="283.67722534797224" ry="28